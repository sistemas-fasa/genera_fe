# Configuracion SMTP para envio de correos.
# Copiar este archivo como .env y completar los valores reales fuera de Git.
#
# NOTA: el .env es OPCIONAL. El sistema toma la configuración SMTP por empresa
# desde la tabla `empresas` (servidor_correo, puerto, usuario_correo,
# pass_correo). Sin .env, el From queda alineado a usuario_correo, por lo que
# cada empresa debe autenticar con su propia dirección de envío.
#
# CASO RECOMENDADO: servicio transaccional (SendGrid / Brevo / Amazon SES / Mailgun)
# para enviar como ventas@ferreteriaavenida.com.ar sin caer en spam.
# 1) Verificar el dominio ferreteriaavenida.com.ar en el proveedor (SPF + DKIM).
# 2) Completar abajo con las credenciales SMTP que da el proveedor.
#    IMPORTANTE: SMTP_FROM debe ser la dirección verificada (ventas@...),
#    aunque SMTP_USER sea una API key (ej. "apikey" en SendGrid).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USER=usuario@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=ventas@ferreteriaavenida.com.ar
# Nombre visible opcional: "Ferreteria Avenida <ventas@ferreteriaavenida.com.ar>"
SMTP_FROM_NAME=Ferreteria Avenida
# Reply-To opcional (por defecto = SMTP_FROM). Ej. mismo ventas@.
SMTP_REPLY_TO=ventas@ferreteriaavenida.com.ar

# Ejemplos por proveedor (descomentar y completar el que uses):
# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=ventas@ferreteriaavenida.com.ar
# --- Brevo ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=ventas@ferreteriaavenida.com.ar
# SMTP_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxx
# SMTP_FROM=ventas@ferreteriaavenida.com.ar
# --- Amazon SES ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=AKIAXXXXXXXXXXXXXXXX
# SMTP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=ventas@ferreteriaavenida.com.ar

# --- Google Workspace (el dominio esta administrado por Google) ---
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=465
# SMTP_USE_TLS=0
# SMTP_USER=ventas@ferreteriaavenida.com.ar
# SMTP_PASSWORD=<app password de 16 caracteres>
# SMTP_FROM=ventas@ferreteriaavenida.com.ar
# Con puerto 465 el codigo usa SMTP_SSL implicitamente; con 587 usa STARTTLS
# (dejar SMTP_USE_TLS=1).

# Limite de correos por hora y por empresa, para no exceder el del servidor
# SMTP. El relay feralex acepta 100/h; con el limite local en 200 el servidor
# respondia "550 Ha alcanzado el limite de 100 por hora" y cada rechazo se
# reintentaba, amplificando el error. Tiene que quedar POR DEBAJO.
# Se puede sobreescribir con el parametro EMAIL_LIMIT_PER_HOUR.
SMTP_HOUR_LIMIT=80

# Notificacion automatica cuando se obtiene un CAEA nuevo.
CAEA_NOTIFICACION_EMAIL=sistemas@ferreteriaavenida.com.ar

# Contingencia CAEA para servidor central.
# "*" o sin configurar procesa todas las filas de fasa.imprefiscal de la empresa.
# Tambien se puede restringir con una lista: CAJA1,CAJA2,CAJA3.
MAQUINAS_IMPREFISCAL=*
# Compatibilidad legacy para instalaciones por caja. En servidor central,
# preferir MAQUINAS_IMPREFISCAL="*" o dejar el default todas.
# MAQUINA_IMPREFISCAL=CAJA1

# Compatibilidad con envios legacy por libs.Utiles.envia_correo.
FASA_ERROR_EMAIL_PASSWORD=change-me
